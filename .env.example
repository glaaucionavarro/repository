# Banco Postgres da Dex Automation
DATABASE_URL=postgres://dex:dex@localhost:5432/dex_automation

# Segredo para cookies e criptografia das chaves salvas no banco (>= 32 caracteres).
# Gere com: openssl rand -hex 32
# ATENÇÃO: se trocar, as chaves de IA salvas deixam de abrir e precisam ser cadastradas de novo.
APP_SECRET=

# Senha de acesso ao painel (usuário único)
ADMIN_PASSWORD=

# Porta HTTP do painel
PORT=3000

# Use true quando o painel estiver atrás de HTTPS
COOKIE_SEGURO=false

# Conta de serviço do Google (JSON completo ou em base64).
# Compartilhe cada planilha de cliente com o client_email dela, como Leitor.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Papéis deste processo: web, worker, agenda (padrão: os três)
PAPEIS=web,worker,agenda

# Opcional: sobrescreve a tabela de preços de IA (USD por 1 milhão de tokens)
# Ex.: {"gpt-4.1":{"entrada":2,"saida":8,"cache":0.5}}
LLM_PRECOS_JSON=
